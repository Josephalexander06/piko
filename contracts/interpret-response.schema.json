{
  "$defs": {
    "CheckboxTarget": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "checkbox",
          "title": "Kind",
          "type": "string"
        },
        "checked": {
          "title": "Checked",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "checked"
      ],
      "title": "CheckboxTarget",
      "type": "object"
    },
    "Clarification": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "targetFieldIds": {
          "items": {
            "maxLength": 64,
            "pattern": "^[a-z]+_[a-f0-9]{32}$",
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Targetfieldids",
          "type": "array"
        }
      },
      "required": [
        "question",
        "targetFieldIds"
      ],
      "title": "Clarification",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "transcript",
            "fact"
          ],
          "title": "Source",
          "type": "string"
        },
        "factId": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z]+_[a-f0-9]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Factid"
        },
        "quote": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "source",
        "factId",
        "quote"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "MissingField": {
      "additionalProperties": false,
      "properties": {
        "fieldId": {
          "maxLength": 64,
          "pattern": "^[a-z]+_[a-f0-9]{32}$",
          "title": "Fieldid",
          "type": "string"
        },
        "question": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "fieldId",
        "question"
      ],
      "title": "MissingField",
      "type": "object"
    },
    "OptionTarget": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "select",
            "radio"
          ],
          "title": "Kind",
          "type": "string"
        },
        "optionId": {
          "maxLength": 64,
          "pattern": "^[a-z]+_[a-f0-9]{32}$",
          "title": "Optionid",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "optionId"
      ],
      "title": "OptionTarget",
      "type": "object"
    },
    "TextTarget": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "text",
            "email",
            "tel",
            "number",
            "date",
            "textarea"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "maxLength": 1024,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "TextTarget",
      "type": "object"
    },
    "Update": {
      "additionalProperties": false,
      "properties": {
        "fieldId": {
          "maxLength": 64,
          "pattern": "^[a-z]+_[a-f0-9]{32}$",
          "title": "Fieldid",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextTarget"
            },
            {
              "$ref": "#/$defs/OptionTarget"
            },
            {
              "$ref": "#/$defs/CheckboxTarget"
            }
          ],
          "title": "Target"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "required": [
        "fieldId",
        "target",
        "evidence"
      ],
      "title": "Update",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "updates": {
      "items": {
        "$ref": "#/$defs/Update"
      },
      "maxItems": 100,
      "title": "Updates",
      "type": "array"
    },
    "clarifications": {
      "items": {
        "$ref": "#/$defs/Clarification"
      },
      "maxItems": 10,
      "title": "Clarifications",
      "type": "array"
    },
    "scanId": {
      "maxLength": 64,
      "pattern": "^[a-z]+_[a-f0-9]{32}$",
      "title": "Scanid",
      "type": "string"
    },
    "missingFields": {
      "items": {
        "$ref": "#/$defs/MissingField"
      },
      "maxItems": 100,
      "title": "Missingfields",
      "type": "array"
    }
  },
  "required": [
    "updates",
    "clarifications",
    "scanId",
    "missingFields"
  ],
  "title": "InterpretResponse",
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://piko.local/schemas/interpret-response.schema.json"
}
