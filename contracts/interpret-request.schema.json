{
  "$defs": {
    "ApprovedFact": {
      "additionalProperties": false,
      "properties": {
        "factId": {
          "maxLength": 64,
          "pattern": "^[a-z]+_[a-f0-9]{32}$",
          "title": "Factid",
          "type": "string"
        },
        "text": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "factId",
        "text"
      ],
      "title": "ApprovedFact",
      "type": "object"
    },
    "Constraints": {
      "additionalProperties": false,
      "properties": {
        "minLength": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minlength"
        },
        "maxLength": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxlength"
        },
        "min": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "max": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "step": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step"
        },
        "patternPresent": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Patternpresent"
        }
      },
      "title": "Constraints",
      "type": "object"
    },
    "EligibleField": {
      "additionalProperties": false,
      "properties": {
        "fieldId": {
          "maxLength": 64,
          "pattern": "^[a-z]+_[a-f0-9]{32}$",
          "title": "Fieldid",
          "type": "string"
        },
        "label": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "type": {
          "enum": [
            "text",
            "email",
            "tel",
            "number",
            "date",
            "textarea",
            "select",
            "radio",
            "checkbox"
          ],
          "title": "Type",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/Option"
          },
          "maxItems": 50,
          "title": "Options",
          "type": "array"
        },
        "constraints": {
          "$ref": "#/$defs/Constraints"
        }
      },
      "required": [
        "fieldId",
        "label",
        "type",
        "required",
        "options",
        "constraints"
      ],
      "title": "EligibleField",
      "type": "object"
    },
    "Option": {
      "additionalProperties": false,
      "properties": {
        "optionId": {
          "maxLength": 64,
          "pattern": "^[a-z]+_[a-f0-9]{32}$",
          "title": "Optionid",
          "type": "string"
        },
        "label": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "optionId",
        "label"
      ],
      "title": "Option",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "scanId": {
      "maxLength": 64,
      "pattern": "^[a-z]+_[a-f0-9]{32}$",
      "title": "Scanid",
      "type": "string"
    },
    "transcript": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Transcript",
      "type": "string"
    },
    "knownFacts": {
      "items": {
        "$ref": "#/$defs/ApprovedFact"
      },
      "maxItems": 50,
      "title": "Knownfacts",
      "type": "array"
    },
    "fields": {
      "items": {
        "$ref": "#/$defs/EligibleField"
      },
      "maxItems": 100,
      "title": "Fields",
      "type": "array"
    }
  },
  "required": [
    "scanId",
    "transcript",
    "knownFacts",
    "fields"
  ],
  "title": "InterpretRequest",
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://piko.local/schemas/interpret-request.schema.json"
}
